NODE_ENV=production
TZ=Asia/Kuala_Lumpur
PORT=3100
# Use the HTTPS staff URL so PWA installation and device notifications work on phones.
APP_BASE_URL=https://dtu-control.internal.example
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://replace-with-your-public-hostname.invalid
PUBLIC_HOSTNAME=replace-with-your-public-hostname.invalid
DATA_DIR=/var/lib/dtu-control
SESSION_DAYS=7
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_TEMPORARY_PASSWORD
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Digital Transformation Unit <replace-with-approved-sender@your-company-domain.invalid>
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_ENCRYPTION_KEY=
MIN_FREE_STORAGE_MB=512
